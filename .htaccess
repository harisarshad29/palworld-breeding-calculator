# Generated by `palworld-breeding-calculator export` — do not edit by hand.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical origin: https://www.palworld-breeding-calculator.us
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^palworld-breeding-calculator\.us$ [NC]
RewriteRule ^(.*)$ https://www.palworld-breeding-calculator.us/$1 [R=301,L]

# Old .html and trailing-slash URLs -> clean URL
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteCond %1 !^google
RewriteRule ^ https://www.palworld-breeding-calculator.us/%1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.palworld-breeding-calculator.us/$1 [R=301,L]

# Server redirects carried over from the Rust app
RewriteRule ^breeding-calculator/?$ https://www.palworld-breeding-calculator.us/ [R=301,L]
RewriteRule ^combo/katress/wixen/?$ https://www.palworld-breeding-calculator.us/?parentA=Katress&parentB=Wixen [R=302,L]
RewriteRule ^palworld-breeding-calculator/?$ https://www.palworld-breeding-calculator.us/ [R=301,L]

# Calculator data: /api/bootstrap -> api/bootstrap.json
RewriteCond %{DOCUMENT_ROOT}/$1.json -f
RewriteRule ^(api/.+)$ $1.json [L]

# Clean URLs: /pal/anubis -> pal/anubis.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

# Combo pairs in reverse order -> the pre-rendered page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/combo/$2/$1.html -f
RewriteRule ^combo/([^/.]+)/([^/.]+)$ https://www.palworld-breeding-calculator.us/combo/$2/$1 [R=301,L]

# Real Pal pairs with no pre-rendered page open in the calculator; anything else is a 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^combo/(aegidron|amione|anubis|arsox|astegon|azurmane|azurobe|azurobe-cryst|bakemi|bastigor|beakon|beakon-cryst|beegarde|bellanoir|bellanoir-libero|blazamut|blazamut-ryu|blazehowl|blazehowl-noct|blue-slime|braloha|bristla|broncherry|broncherry-aqua|bulldosu|bushi|bushi-noct|caprity|caprity-noct|carnibora|cattiva|cave-bat|cawgnito|celaray|celaray-lux|celesdir|celesdir-noct|chikipi|chillet|chillet-ignis|cinnamoth|clovee|cremis|croajiro|croajiro-noct|cryolinx|cryolinx-terra|daedream|dandilord|dazemu|dazzi|dazzi-noct|demon-eye|depresso|digtoise|dinossom|dinossom-lux|direhowl|dogen|dualith|dualith-noct|dumud|dumud-gild|dupin|dynamoff|eidrolon|eidrolon-ignis|eikthyrdeer|eikthyrdeer-terra|elgrove|elgrove-cryst|elizabee|elphidran|elphidran-aqua|enchanted-sword|eye-of-cthulhu|faleris|faleris-aqua|felbat|fenglope|fenglope-lux|finsider|finsider-ignis|flambelle|flaracle|flopie|foxcicle|foxparks|foxparks-cryst|frostallion|frostallion-noct|frostplume|fuack|fuack-ignis|fuddler|galeclaw|ghangler|ghangler-ignis|gildane|gildra|gloopie|gloopie-primo|gobfin|gobfin-ignis|gorirat|gorirat-terra|green-slime|grintale|grizzbolt|gumoss|gumoss-flower|hangyu|hangyu-cryst|hartalis|helzephyr|helzephyr-lux|herbil|hoocrates|hoodle|icelyn|illuminant-bat|illuminant-slime|incineram|incineram-noct|jelliette|jellroy|jetragon|jolthog|jolthog-cryst|jormuntide|jormuntide-ignis|katress|katress-ignis|kelpsea|kelpsea-ignis|kikit|killamari|killamari-primo|kingpaca|kingpaca-cryst|kitsun|kitsun-noct|knocklem|knocklem-ignis|lamball|lapiron|lapure|leafan|leezpunk|leezpunk-ignis|lifmunk|loomen|loupmoon|loupmoon-cryst|lovander|lullu|lunaris|lyleen|lyleen-noct|majex|mammorest|mammorest-cryst|maraith|mau|mau-cryst|melpaca|menasting|menasting-terra|mimog|moldron|moldron-cryst|mossanda|mossanda-lux|mozzarina|muffly|munchill|mycora|necromus|needoll|needoll-noct|neptilius|nitemary|nitemary-botan|nitewing|nox|nyafia|omascul|ophydia|orserk|paladius|palumba|panthalus|pengullet|pengullet-lux|penking|penking-lux|pe